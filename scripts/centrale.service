[Unit]
Description=Centrale de Performance Marine
After=network.target signalk.service
Wants=signalk.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/voile
ExecStart=/home/pi/voile/venv/bin/python main.py --mode log
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
